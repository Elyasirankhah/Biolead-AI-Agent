# Frontend (Vercel / local Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend (AWS / local FastAPI)
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
ENSEMBLE_REQUIRED=true

# MongoDB (optional locally — API still works without it)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=biolead

# Redis evidence cache (optional — falls back to in-memory TTL cache)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_HOURS=24
ORCHESTRATOR_RETRIES=2
RAG_LIT_KEEP=5

# Supabase auth (optional — guest mode works until AUTH_REQUIRED=true)
# New projects: JWKS URL is enough for API token verify. JWT secret is legacy HS256 only.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
AUTH_REQUIRED=false
